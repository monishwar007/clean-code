<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Minimal Checkstyle ruleset enforcing the size/naming limits from
  clean-code.md and complexity.md. Not exhaustive — extend per project.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <!-- Size limits (complexity.md) -->
        <module name="MethodLength">
            <property name="max" value="30"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="ClassDataAbstractionCoupling">
            <property name="max" value="10"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="4"/>
        </module>

        <!-- Naming (clean-code.md) -->
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ConstantName"/>

        <!-- Error handling (code-smells.md) -->
        <module name="EmptyCatchBlock"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="Exception, Throwable, RuntimeException"/>
        </module>

        <!-- Field injection ban (java-spring-boot.md) -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="@Autowired\s*$"/>
            <property name="message" value="Field injection is banned — use constructor injection."/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- Nesting depth -->
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>
    </module>

    <module name="FileLength">
        <property name="max" value="300"/>
    </module>
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>
</module>
